# ==============================================================================
# SCIENCE STUDIO - VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development.
# When deploying to Vercel, add these variables in:
# Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Vite Frontend)
# Note: Use only the public anon key for VITE_SUPABASE_ANON_KEY.
# NEVER expose the service_role key to the frontend!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Serverless Backend Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# ------------------------------------------------------------------------------
# 3. Application Environment Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://your-app-name.vercel.app

# ------------------------------------------------------------------------------
# 4. Optional Backend Overrides
# ------------------------------------------------------------------------------
# ADMIN_TOKEN=your-custom-admin-secret-token
# GEMINI_API_KEY=your-gemini-api-key


